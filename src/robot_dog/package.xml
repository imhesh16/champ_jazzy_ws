<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>robot_dog</name>

  <version>0.0.1</version>

  <description>
    Descripcion, configuracion y archivos de lanzamiento del perro robot
    controlado mediante CHAMP en ROS 2 Jazzy.
  </description>

  <maintainer email="emilio.valenzuela.c@usach.cl">
    Emilio Valenzuela
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Sistema de compilacion -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencias utilizadas por los launch files -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <!-- Procesamiento y publicacion del modelo -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Controlador cuadrupedo -->
  <exec_depend>champ_base</exec_depend>

  <!-- Visualizacion -->
  <exec_depend>rviz2</exec_depend>

  <!-- Mensajes utilizados por el sistema -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <!-- Pruebas y comprobaciones -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>